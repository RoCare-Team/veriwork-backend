NODE_ENV=development
PORT=8080

# Local development
MONGODB_URI=mongodb://localhost:27017/veriwork

# Production (MongoDB Atlas) — set in Vercel Environment Variables
# MONGODB_URI=mongodb+srv://DB_USER:DB_PASSWORD@cluster0.xxxxx.mongodb.net/veriwork?retryWrites=true&w=majority
# If password has special chars (@ # % etc), URL-encode them in the connection string.

# --- Platform admin console ---
# Seeded at boot. REQUIRED in production — without both, the admin seed is
# skipped. In development a local-only fallback is used instead.
ADMIN_EMAIL=admin@pagerlook.local
ADMIN_PASSWORD=change-me-strong-admin-password

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Accept one or more comma-separated frontend origins.
# Example: CORS_ORIGIN=http://localhost:5173,https://app.pagerlook.com
CORS_ORIGIN=http://localhost:5173

# Google OAuth (Employee login)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

OTP_MOCK_CODE=123456
OTP_EXPIRES_MINUTES=10

# SMS gateway (savshka) for phone OTP. Leave SMS_API_KEY blank to keep OTP in
# dev mock mode (fixed OTP_MOCK_CODE, no SMS sent). The sender ID, DLT entity ID
# and template ID must exactly match what's registered on DLT.
# SMS_API_URL=https://api.savshka.co.in/api/sms
# SMS_API_KEY=your-savshka-api-key
# SMS_SENDER_ID=TLGCRO
# SMS_ENTITY_ID=your-dlt-entity-id
# SMS_OTP_TEMPLATE_ID=your-dlt-otp-template-id
# SMS_BRAND_NAME=Ro Care India

UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# AWS S3
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=pager-look

# ─────────────────────────────────────────────────────────────────────────────
# Face match (biometric step) — AWS Rekognition CompareFaces/DetectFaces.
# Enabled automatically when the AWS keys above are set; the IAM user needs
# rekognition:CompareFaces + rekognition:DetectFaces (and s3:GetObject on the
# bucket, since the Aadhaar photo is read straight from S3).
# Set FACE_MATCH_ENABLED=false to force it off. With it off, the biometric step
# is a mock in development and a hard error in production.
# ─────────────────────────────────────────────────────────────────────────────
# FACE_MATCH_ENABLED=true
# AWS_REKOGNITION_REGION=ap-south-1
# Similarity (0-100) the selfie must reach against the Aadhaar card photo.
# FACE_MATCH_MIN_SIMILARITY=85
# FACE_MATCH_MIN_CONFIDENCE=95
# FACE_MATCH_MAX_POSE_DEGREES=30
# FACE_MATCH_MIN_SHARPNESS=20
# FACE_MATCH_MIN_BRIGHTNESS=20
# Degrees of head turn required across the liveness frames.
# FACE_MATCH_MIN_YAW_SPREAD=18
# FACE_MATCH_MAX_ATTEMPTS=8

# ─────────────────────────────────────────────────────────────────────────────
# Email / SMTP  —  ALL outgoing system email uses ONLY these variables.
# The app code is provider-agnostic: to move from Gmail to Amazon SES (or change
# the sender to verification@ / support@ / noreply@pagerlook.com) change ONLY the
# values below — no code changes required. Never commit real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# --- Development: Gmail SMTP ---
# 1. Enable 2-Step Verification on skc26601@gmail.com
# 2. Create an "App password" (Google Account > Security > App passwords)
# 3. Paste the 16-char app password (no spaces) into SMTP_PASS below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=raftaarnews02@gmail.com
SMTP_PASS=your-16-char-gmail-app-password
SMTP_FROM=PagerLook <raftaarnews02@gmail.com>
# SMTP_REPLY_TO=support@pagerlook.com

# --- Production: swap values only, e.g. Amazon SES ---
# SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=<SES-SMTP-username>
# SMTP_PASS=<SES-SMTP-password>
# SMTP_FROM=PagerLook <verification@pagerlook.com>

# --- Optional email branding (used by the shared HTML template) ---
# EMAIL_BRAND_NAME=PagerLook
# EMAIL_BRAND_TAGLINE=Verify. Trust. Grow.
# EMAIL_BRAND_COLOR=#1e3a8a
# EMAIL_LOGO_URL=https://pagerlook.com/pagerLookLogo.png
# EMAIL_SUPPORT=info@pagerlook.com
# Support phone in E.164 — drives both the tel: and wa.me links in the footer
# EMAIL_SUPPORT_PHONE=+918510099972
# EMAIL_INSTAGRAM_URL=https://www.instagram.com/pagerlook/
